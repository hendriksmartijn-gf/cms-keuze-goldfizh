# Origins die de keuzehulp mogen embedden (komma-gescheiden)
ALLOWED_PARENT_ORIGINS=https://www.goldfizh.nl,https://goldfizh.webflow.io

# Leads per e-mail via Resend. Afzenderdomein moet in Resend geverifieerd zijn (DNS).
RESEND_API_KEY=
LEAD_EMAIL_TO=martijn@goldfizh.nl
LEAD_EMAIL_FROM=CMS-keuzehulp <keuzehulp@goldfizh.nl>

# Optioneel, later: leads ook naar CRM (HubSpot-workflow, n8n, …) + Bearer-secret
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optioneel: matrix uit Sanity i.p.v. data/matrix.json
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Secret voor de Sanity-webhook naar /api/revalidate?secret=…
REVALIDATE_SECRET=

NEXT_PUBLIC_PRIVACY_URL=https://www.goldfizh.nl/privacy
